    const int in_offset = (((batch_idx * ((channels+3)/4) + channel_4_idx/4) * height + height_idx) * width + width_idx)*4;

    float4 values        = convert_float4(vload4(0, input_ptr+in_offset));
    const int remain_channel = channels - channel_4_idx;
    if (remain_channel >= 4) {
